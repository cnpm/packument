{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", ":preserveSemverRanges", ":disablePeerDependencies"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi/cli", "napi", "napi-build", "napi-derive"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "groupName": "linter",
      "matchPackageNames": ["/^eslint/", "/^@typescript-eslint/"]
    },
    {
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite-plus",
      "groupSlug": "vite-plus",
      "separateMajorMinor": false
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": []
}
