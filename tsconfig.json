{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "strict": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true
  },
  "include": ["js"],
  "exclude": ["node_modules", "benchmark", "__test__"]
}
