{
  "name": "@cnpmjs/packument",
  "version": "1.7.0",
  "description": "Packument helper",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cnpm/packument.git"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api",
    "packument",
    "cnpm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./js/index.js",
      "types": "./js/index.d.ts"
    }
  },
  "files": [
    "js",
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "napi": {
    "binaryName": "packument",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "ready": "vp run build && vp check && vp run fallow && vp test",
    "artifacts": "napi artifacts",
    "prebench": "vp run build",
    "bench": "node benchmark/bench.ts && node benchmark/bench_real_case.ts && node benchmark/bench_memory.ts && vp run bench:gc",
    "bench:gc": "vp run bench:gc:add_version && vp run bench:gc:get_property_value",
    "bench:gc:add_version": "GC=1 node benchmark/add_version.ts && GC=1 node benchmark/add_version.ts SonicJSONParse",
    "bench:gc:get_property_value": "GC=1 node benchmark/get_property_value.ts && GC=1 node benchmark/get_property_value.ts SonicJSONParse",
    "build": "node scripts/tsrs.js && napi build --platform --release --esm",
    "build:debug": "node scripts/tsrs.js && napi build --platform --esm",
    "format": "run-p format:js format:rs format:toml",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "vp lint --type-aware --type-check js",
    "prepublishOnly": "node scripts/tsrs.js && napi prepublish -t npm",
    "pretest": "vp run build",
    "test": "vp test",
    "preversion": "napi build --platform --esm && git add .",
    "version": "napi version",
    "prepare": "vp config --no-agent",
    "check": "vp check",
    "format:js": "vp fmt .",
    "test:consumer": "node scripts/test-consumer.mjs",
    "fallow": "fallow dead-code --fail-on-issues"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "^6.0.0",
    "@e18e/eslint-plugin": "^0.8.1",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@taplo/cli": "^0.7.0",
    "@ts-rs/wasm": "0.15.0-ts7.1.0-dev.20260929",
    "@types/node": "^24.10.1",
    "fallow": "^3.33.1",
    "npm-run-all2": "^8.0.4",
    "tinybench": "^6.0.0",
    "tsrs": "0.15.0-ts7.1.0-dev.20260929",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
