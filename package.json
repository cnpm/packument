{
  "name": "@cnpmjs/packument",
  "version": "1.7.0",
  "description": "Packument helper",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cnpm/packument.git"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api",
    "packument",
    "cnpm"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./js/index.js",
      "types": "./js/index.d.ts"
    }
  },
  "files": [
    "js",
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "napi": {
    "binaryName": "packument",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "aarch64-unknown-linux-musl",
      "aarch64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">= 20.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "ready": "yarn build && yarn lint && yarn test",
    "artifacts": "napi artifacts",
    "prebench": "yarn build",
    "bench": "node benchmark/bench.ts && node benchmark/bench_memory.ts && yarn bench:gc",
    "bench:gc": "yarn bench:gc:add_version && yarn bench:gc:get_property_value",
    "bench:gc:add_version": "GC=1 node benchmark/add_version.ts && GC=1 node benchmark/add_version.ts SonicJSONParse",
    "bench:gc:get_property_value": "GC=1 node benchmark/get_property_value.ts && GC=1 node benchmark/get_property_value.ts SonicJSONParse",
    "build": "tsc && napi build --platform --release --esm",
    "build:debug": "tsc && napi build --platform --esm",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint --type-aware --type-check js",
    "prepublishOnly": "tsc && napi prepublish -t npm",
    "pretest": "yarn build",
    "test": "vitest run",
    "preversion": "napi build --platform --esm && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@codspeed/tinybench-plugin": "^5.0.1",
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.0.35",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/node": "^24.10.1",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.31.0",
    "oxlint-tsgolint": "^0.11.0",
    "prettier": "^3.6.2",
    "tinybench": "^5.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.10"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ],
    "*.rs": [
      "cargo fmt --"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.12.0"
}
